<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nourish_launch_overlay" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FDF6E3" android:fitsSystemWindows="true" android:importantForAccessibility="noHideDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center" android:paddingHorizontal="24dp">
        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_marginBottom="12dp"
            android:src="@drawable/nourish_launch_logo" android:tint="#C9A84C" android:scaleType="fitCenter" android:contentDescription="Nourish Spoon logo" />
        <TextView android:id="@+id/launch_brand" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Nourish Spoon™" android:textColor="#1B4332" android:textSize="32sp" android:gravity="center" android:includeFontPadding="false" />
        <TextView android:id="@+id/launch_tagline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Crafted with Love" android:textColor="#C9A84C" android:textSize="18sp" android:gravity="center" android:layout_marginTop="4dp" android:includeFontPadding="false" />
        <TextView android:id="@+id/launch_slogan" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Wholesome Nutrition\nfor Healthier Tomorrows" android:textColor="#1B4332" android:textSize="18sp" android:gravity="center" android:layout_marginTop="28dp" android:includeFontPadding="false" />
        <TextView android:id="@+id/launch_products" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Homemade Panjeeri &amp; Date-Nut Laddus" android:textColor="#1B4332" android:textSize="13sp" android:gravity="center" android:layout_marginTop="12dp" android:includeFontPadding="false" />
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true"
        android:src="@drawable/nourish_launch_food" android:scaleType="fitCenter" android:contentDescription="Homemade Panjeeri and date-nut laddus" />
    <TextView android:id="@+id/launch_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="100% Natural | Handmade | Pakistani Goodness" android:textColor="#1B4332" android:textSize="11sp"
        android:gravity="center" android:paddingVertical="20dp" android:includeFontPadding="false" />
</LinearLayout>
