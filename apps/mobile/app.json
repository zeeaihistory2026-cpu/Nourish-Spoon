{
  "expo": {
    "name": "Nourish Spoon",
    "slug": "nourish-spoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/website/logo-transparent.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/website/logo-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF6E3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nourishspoon.app"
    },
    "android": {
      "versionCode": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/website/logo-transparent.png",
        "backgroundColor": "#FDF6E3"
      },
      "package": "com.nourishspoon.app"
    },
    "web": {
      "favicon": "./assets/website/logo-transparent.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "./plugins/withReleaseSigning",
      "./plugins/withNativeLaunch",
      [
        "expo-notifications",
        {
          "defaultChannel": "nourish-updates",
          "color": "#003E31"
        }
      ],
      "./plugins/withFirebaseMessaging",
      "expo-sharing"
    ],
    "scheme": "nourishspoon"
  }
}
