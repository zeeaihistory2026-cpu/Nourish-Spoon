# Dependencies
node_modules/
*/node_modules/

# Environment files & Secrets
.env
.env*.local
*.env
!.env.example
apps/admin/.env
apps/mobile/.env

# Production and Expo
.expo/
dist/
web-build/

# Installers belong in GitHub Releases, never in source control.
*.apk
*.aab
*.apks
*.ipa

# Private signing and service-account files. The standard Android debug fixture is public.
*.jks
*.keystore
!apps/mobile/android/app/debug.keystore
*.pem
*.p12
*.p8
*service-account*.json
*serviceAccount*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# System and Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Android signing material
apps/mobile/android/keystores/
apps/mobile/android/signing.properties
apps/mobile/android/.kotlin/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/app/.cxx/

apps/mobile/dist-*/
artifacts/
# Local handover documents and rendered review files
output/
tmp/
# Release keys are kept outside Expo's regenerated native folders.
private-signing/
functions/lib/
*-debug.log

# Next.js and build caches
.next/
*.tsbuildinfo
.turbo/

# Python cache
__pycache__/
*.pyc

# Separate repositories
Noor-Ai/

# Local Firebase Android client configuration (public config provisioned per build).
apps/mobile/private-config/
apps/mobile/android/app/src/main/res/values/nourish_firebase.xml
